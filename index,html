<!-- Custom Floating Tooltip Element (Thay thế title mặc định của trình duyệt) -->
<div id="cyberFloatingTooltip" class="cyber-floating-tooltip" role="tooltip"></div>
<script>
    (function initCustomCyberUI() {
        const tooltipEl = document.getElementById('cyberFloatingTooltip');
        if (!tooltipEl) return;

        function convertNativeTitles(root = document) {
            root.querySelectorAll('[title]').forEach(el => {
                if (el.tagName === 'IFRAME') return;
                const t = el.getAttribute('title');
                if (t && t.trim()) {
                    el.setAttribute('data-custom-tooltip', t.trim());
                    el.removeAttribute('title');
                }
            });
        }

        convertNativeTitles();
        const observer = new MutationObserver(mutations => {
            mutations.forEach(m => {
                m.addedNodes.forEach(node => {
                    if (node.nodeType === 1) {
                        if (node.hasAttribute && node.hasAttribute('title') && node.tagName !== 'IFRAME') {
                            node.setAttribute('data-custom-tooltip', node.getAttribute('title'));
                            node.removeAttribute('title');
                        }
                        convertNativeTitles(node);
                    }
                });
            });
        });
        observer.observe(document.body, { childList: true, subtree: true });

        document.addEventListener('mouseover', e => {
            const target = e.target.closest('[data-custom-tooltip]');
            if (!target) return;
            const text = target.getAttribute('data-custom-tooltip');
            if (!text) return;
            tooltipEl.textContent = text;
            tooltipEl.classList.add('show');
        });

        document.addEventListener('mousemove', e => {
            if (!tooltipEl.classList.contains('show')) return;
            const x = Math.min(window.innerWidth - tooltipEl.offsetWidth - 14, Math.max(10, e.clientX + 14));
            const y = Math.min(window.innerHeight - tooltipEl.offsetHeight - 14, Math.max(10, e.clientY + 18));
            tooltipEl.style.left = x + 'px';
            tooltipEl.style.top = y + 'px';
        });

        document.addEventListener('mouseout', e => {
            const target = e.target.closest('[data-custom-tooltip]');
            if (target) tooltipEl.classList.remove('show');
        });
    })();
</script>

